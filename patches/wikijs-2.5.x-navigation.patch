+}
+
+.nav-tree-entry-main {
+  display: flex;
+  align-items: center;
+  min-height: 46px;
+  padding: 0 8px;
+  border: 1px solid rgba(0, 0, 0, .08);
+  border-radius: 4px;
+  background: #FFF;
+  cursor: pointer;
+  transition: border-color .15s ease, background-color .15s ease, box-shadow .15s ease;
+}
+
+.nav-tree-entry-main:hover {
+  border-color: rgba(0, 150, 136, .65);
+  box-shadow: 0 2px 5px rgba(0, 0, 0, .08);
+}
+
+.nav-tree-entry-selected .nav-tree-entry-main {
+  border-color: #009688;
+  background: rgba(0, 150, 136, .08);
+  box-shadow: 0 2px 6px rgba(0, 150, 136, .14);
+}
+
+.nav-tree-entry-match .nav-tree-entry-main {
+  background: rgba(255, 193, 7, .18);
+}
+
+.nav-tree-handle {
+  cursor: grab;
+}
+
+.nav-tree-handle:active {
+  cursor: grabbing;
+}
+
+.nav-tree-expand {
+  flex: 0 0 32px;
+}
+
+.nav-tree-expand-spacer {
+  flex: 0 0 32px;
+  width: 32px;
+  height: 32px;
+}
+
+.nav-tree-label {
+  flex: 0 0 280px;
+  width: 280px;
+  min-width: 0;
+  overflow: hidden;
+  text-align: left;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.nav-tree-label-level-1 {
+  font-weight: 700;
+}
+
+.nav-tree-label-level-2 {
+  font-weight: 400;
+}
+
+.nav-tree-label-level-3 {
+  font-weight: 300;
+}
+
+.nav-tree-kind-chip {
+  min-width: 42px;
+  justify-content: center;
+}
+
+.nav-tree-children {
+  margin: 4px 0;
+}
+
+.nav-tree-empty {
+  min-height: 36px;
+  margin: 4px 0;
+  padding: 8px 12px;
+  border: 1px dashed rgba(0, 150, 136, .45);
+  border-radius: 4px;
+  color: #607D8B;
+  text-align: center;
+}
+
+.nav-tree-ghost .nav-tree-entry-main {
+  background: rgba(0, 150, 136, .16);
+  border: 1px dashed #009688;
+}
+</style>
