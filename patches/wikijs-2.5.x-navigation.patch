+
+  static validateTree(tree = []) {
+    const locales = Array.isArray(tree) ? tree : []
+    locales.forEach(localeTree => {
+      const items = Array.isArray(localeTree.items) ? localeTree.items : []
+      const byId = new Map()
+
+      items.forEach(item => {
+        if (!item || !item.id) {
