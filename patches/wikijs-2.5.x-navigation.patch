+<template lang='pug'>
+  .nav-tree-branch(:class='`nav-tree-level-${level + 1}`')
+    draggable.nav-tree-list(
+      :list='nodes'
+      :group='groupOptions'
+      :animation='160'
+      handle='.nav-tree-handle'
+      ghost-class='nav-tree-ghost'
+      chosen-class='nav-tree-chosen'
+      @start='$emit(`drag-start`)'
+      @change='$emit(`change`, $event)'
+      @end='$emit(`drag-end`)'
+      )
+      template(v-for='node in nodes')
+        .nav-tree-entry(
+          :key='node.id'
+          :class='{ "nav-tree-entry-selected": selectedId === node.id, "nav-tree-entry-match": isMatch(node) }'
+          )
+          .nav-tree-entry-main(@click='$emit(`select`, node)')
+            v-btn.nav-tree-handle(icon, small, :aria-label='`拖动${node.label || `未命名节点`}`')
+              v-icon(small) mdi-drag-vertical
+            v-btn.nav-tree-expand(
+              v-if='hasChildren(node)'
+              icon
+              small
+              :aria-label='isExpanded(node) ? `收起${node.label || `未命名节点`}` : `展开${node.label || `未命名节点`}`'
+              @click.stop='toggle(node)'
+              )
+              v-icon(small) {{ isExpanded(node) ? `mdi-chevron-down` : `mdi-chevron-right` }}
+            .nav-tree-expand-spacer(v-else)
+            .nav-tree-label(:class='`nav-tree-label-level-${level + 1}`') {{node.label || '未命名节点'}}
+            v-chip.ml-2(x-small, outlined) {{levelLabel(level)}}
+            v-chip.ml-2.nav-tree-kind-chip(x-small, :color='kindColor(node)', outlined) {{kindLabel(node)}}
+            v-spacer
+            v-btn(
+              v-if='level < 2'
+              icon
+              small
+              aria-label='添加子项'
+              @click.stop='$emit(`add-child`, node)'
+              )
+              v-icon(small) mdi-plus
+          .nav-tree-children(v-show='isExpanded(node)', v-if='level < 2')
+            navigation-tree-node(
+              :nodes='node.children'
+              :level='level + 1'
+              :selected-id='selectedId'
+              :search='search'
+              :group-name='groupName'
+              @select='$emit(`select`, $event)'
+              @add-child='$emit(`add-child`, $event)'
+              @drag-start='$emit(`drag-start`)'
+              @change='$emit(`change`, $event)'
+              @drag-end='$emit(`drag-end`)'
+              )
+    .nav-tree-empty(v-if='nodes.length === 0')
+      v-icon.mr-2(small) mdi-arrow-down
+      span {{level === 0 ? '暂无导航，请点击“添加根节点”开始' : '可将节点拖拽到此处设置为子项'}}
+</template>
+
+<script>
+import draggable from 'vuedraggable'
+
+export default {
+  name: 'NavigationTreeNode',
+  components: {
+    draggable
+  },
+  props: {
+    nodes: {
+      type: Array,
+      default: () => []
+    },
+    level: {
+      type: Number,
+      default: 0
+    },
+    selectedId: {
+      type: String,
+      default: ''
+    },
+    search: {
+      type: String,
+      default: ''
+    },
+    groupName: {
+      type: String,
+      default: 'wiki-navigation-tree'
+    }
+  },
+  data() {
+    return {
+      expanded: {}
+    }
+  },
+  computed: {
+    groupOptions() {
+      return {
+        name: this.groupName,
+        pull: true,
+        put: true
+      }
+    }
+  },
+  watch: {
+    nodes: {
+      deep: true,
+      handler() {
+        this.expandBranches()
+      }
+    }
+  },
+  created() {
+    this.expandBranches()
+    this.$root.$on('navigation-tree-expand-all', this.expandAll)
+    this.$root.$on('navigation-tree-collapse-all', this.collapseAll)
+  },
+  beforeDestroy() {
+    this.$root.$off('navigation-tree-expand-all', this.expandAll)
+    this.$root.$off('navigation-tree-collapse-all', this.collapseAll)
+  },
+  methods: {
+    hasChildren(node) {
+      return Boolean(node && node.children && node.children.length > 0)
+    },
+    expandBranches() {
+      this.nodes.forEach(node => {
+        if (node.children && node.children.length > 0 && typeof this.expanded[node.id] === 'undefined') {
+          this.$set(this.expanded, node.id, true)
+        }
+      })
+    },
+    expandAll() {
+      this.nodes.forEach(node => this.$set(this.expanded, node.id, true))
+    },
+    collapseAll() {
+      this.nodes.forEach(node => this.$set(this.expanded, node.id, false))
+    },    toggle(node) {
+      this.$set(this.expanded, node.id, !this.isExpanded(node))
+    },
+    isExpanded(node) {
+      return this.expanded[node.id] === true
+    },
+    isMatch(node) {
+      const query = (this.search || '').trim().toLocaleLowerCase()
+      return Boolean(query && (node.label || '').toLocaleLowerCase().indexOf(query) >= 0)
+    },
+    levelLabel(level) {
+      return `${level + 1}级`
+    },
+    kindLabel(node) {
+      if (node.kind === 'header') return '分组'
+      if (node.kind === 'divider') return '分隔线'
+      return '链接'
+    },
+    kindColor(node) {
+      if (node.kind === 'header') return 'teal'
+      if (node.kind === 'divider') return 'grey'
+      return 'primary'
+    }
+  }
+}
+</script>
+
+<style lang='scss' scoped>
+.nav-tree-list {
+  min-height: 10px;
+}
+
+.nav-tree-entry {
+  margin: 3px 0;
