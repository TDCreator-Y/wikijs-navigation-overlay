+</template>
+
+<script>
+import _ from 'lodash'
+import gql from 'graphql-tag'
+import { v4 as uuid } from 'uuid'
+
+import groupsQuery from 'gql/admin/users/users-query-groups.gql'
+import NavigationTreeNode from './admin-navigation-tree-node.vue'
+
+/* global siteConfig, siteLangs */
+
+export default {
+  components: {
+    NavigationTreeNode
+  },
+  data() {
+    return {
+      trees: [],
+      treeNodes: [],
+      selectedId: '',
+      currentLang: siteConfig.lang,
+      loadedLang: siteConfig.lang,
+      allLocales: [],
+      groups: [],
+      search: '',
+      saving: false,
+      isDirty: false,
+      dragSnapshot: null,
+      selectPageModal: false,
+      config: {
+        mode: 'NONE'
+      },
+      nodeKinds: [
+        { text: '链接', value: 'link' },
+        { text: '分组标题', value: 'header' },
+        { text: '分隔线', value: 'divider' }
+      ],
+      targetTypes: [
+        { text: '站点首页', value: 'home' },
+        { text: 'Wiki.js 页面', value: 'page' },
+        { text: '外部链接', value: 'external' },
+        { text: '外部链接（新窗口打开）', value: 'externalblank' }
+      ]
+    }
+  },
+  computed: {
+    localeOptions() {
+      return _.intersectionBy(this.allLocales, _.unionBy(siteLangs, [{ code: 'en' }, { code: siteConfig.lang }], 'code'), 'code')
+    },
+    currentItems() {
+      const tree = _.find(this.trees, ['locale', this.loadedLang])
+      return tree ? (tree.items || []) : []
+    },
+    selected() {
+      return this.findNode(this.treeNodes, this.selectedId)
+    },
+    selectedDepth() {
+      const result = this.findNodeWithDepth(this.treeNodes, this.selectedId, 1)
+      return result ? result.depth : 1
+    },
+    selectedParentLabel() {
+      if (!this.selected || !this.selected.parentId) return '根节点'
+      const parent = this.findNode(this.treeNodes, this.selected.parentId)
+      return parent ? (parent.label || '未命名节点') : '根节点'
+    },
+    modeLabel() {
+      return {
+        TREE: '站点地图',
+        STATIC: '静态导航',
+        MIXED: '自定义导航',
+        NONE: '无'
+      }[this.config.mode] || '未设置'
+    }
+  },
+  watch: {
+    trees: {
+      deep: true,
+      handler() {
+        if (!this.isDirty) this.loadCurrentLocale()
+      }
+    }
+  },
+  beforeRouteLeave(to, from, next) {
+    if (this.isDirty && !window.confirm('当前有未保存的修改，离开页面后将丢失。是否继续？')) {
+      next(false)
+      return
+    }
+    next()
+  },
+  methods: {
+    loadCurrentLocale() {
+      this.loadedLang = this.currentLang
+      this.treeNodes = this.buildTree(this.currentItems)
+      this.selectedId = ''
+      this.dragSnapshot = null
+    },
+    switchLocale(nextLocale) {
+      if (this.isDirty && !window.confirm('当前语言有未保存的修改，切换后将丢失这些修改。是否继续？')) {
+        this.$nextTick(() => { this.currentLang = this.loadedLang })
+        return
+      }
+      this.isDirty = false
+      this.currentLang = nextLocale
+      this.loadCurrentLocale()
+    },
+    buildTree(items) {
+      const source = Array.isArray(items) ? items : []
+      const nodes = source.map((item, index) => ({
+        ..._.cloneDeep(item),
+        id: String(item.id || uuid()),
+        kind: item.kind || 'link',
+        label: item.label || '',
+        icon: item.icon || '',
+        targetType: item.targetType || 'page',
+        target: item.target || '',
+        parentId: item.parentId || null,
+        order: Number.isFinite(Number(item.order)) ? Number(item.order) : index,
+        children: []
+      }))
+      const byId = _.keyBy(nodes, 'id')
+      const roots = []
+      const hasExplicitParent = nodes.some(node => Boolean(node.parentId))
+
+      if (!hasExplicitParent) {
+        let section = null
+        nodes.forEach(node => {
+          if (node.kind === 'header') {
+            section = node
+            roots.push(node)
+          } else if (node.kind === 'link' && section) {
+            node.parentId = section.id
+            section.children.push(node)
+          } else {
+            if (node.kind === 'divider') section = null
+            roots.push(node)
+          }
+        })
+      } else {
+        nodes.forEach(node => {
+          const parent = node.parentId ? byId[node.parentId] : null
+          if (parent && parent.id !== node.id) parent.children.push(node)
+          else roots.push(node)
+        })
+        let section = null
+        const groupedRoots = []
+        roots.forEach(node => {
+          if (node.parentId) {
+            section = null
+            groupedRoots.push(node)
+          } else if (node.kind === 'header') {
+            section = node
+            groupedRoots.push(node)
