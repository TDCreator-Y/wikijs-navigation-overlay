+        }
+        const id = String(item.id)
+        if (byId.has(id)) {
+          throw new Error(`Navigation item id ${id} is duplicated in locale ${localeTree.locale || 'unknown'}.`)
+        }
+        byId.set(id, item)
+      })
+
+      items.forEach(item => {
+        let depth = 1
+        let parentId = item.parentId || null
+        const seen = new Set([String(item.id)])
+        while (parentId) {
+          parentId = String(parentId)
+          if (seen.has(parentId)) {
+            throw new Error(`Navigation item ${item.id} contains a parent cycle.`)
+          }
+          const parent = byId.get(parentId)
+          if (!parent) {
+            throw new Error(`Navigation item ${item.id} references missing parent ${parentId}.`)
+          }
+          seen.add(parentId)
+          depth += 1
+          if (depth > 3) {
+            throw new Error(`Navigation item ${item.id} exceeds the maximum depth of 3.`)
+          }
+          parentId = parent.parentId || null
+        }
+      })
     })
+    return true
   }
