+  min-height: 38px;
+  flex: 1 1 auto;
+  min-width: 0;
+  color: inherit;
+  text-decoration: none;
+  text-align: left;
+  background: transparent;
+  border: 0;
+  cursor: pointer;
+  font: inherit;
+}
+
+.nav-tree-link:hover,
+.nav-tree-label-button:hover {
+  color: inherit;
+}
+
+.nav-tree-link-active {
+  font-weight: 600;
+}
+
+.nav-tree-icon {
+  flex: 0 0 24px;
+  margin-right: 6px;
+}
+
+.nav-tree-label {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.nav-tree-children {
+  margin-left: 16px;
+}
