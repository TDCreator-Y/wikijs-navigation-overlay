+            v-if='isLink(node)'
+            :href='node.target'
+            :target='node.targetType === `externalblank` ? `_blank` : `_self`'
+            :rel='node.targetType === `externalblank` ? `noopener noreferrer` : ``'
+            :class='{ "nav-tree-link-active": isActive(node) }'
+            )
+            v-icon.nav-tree-icon(v-if='node.icon', size='18') {{ node.icon }}
+            span.nav-tree-label {{ node.label }}
+          button.nav-tree-label-button(
+            v-else
+            type='button'
+            :aria-expanded='hasVisibleChildren(node) ? String(isExpanded(node)) : undefined'
+            @click='hasVisibleChildren(node) ? toggle(node) : undefined'
+            )
+            v-icon.nav-tree-icon(v-if='node.icon', size='18') {{ node.icon }}
+            span.nav-tree-label {{ node.label }}
+        .nav-tree-children(v-if='hasVisibleChildren(node)', v-show='isExpanded(node)')
+          nav-sidebar-tree(
+            :nodes='node.children'
+            :color='color'
+            :dark='dark'
+            :path='path'
+            :level='level + 1'
+            )
+</template>
+
+<script>
+import _ from 'lodash'
+
+export default {
+  name: 'NavSidebarTree',
+  props: {
+    items: {
+      type: Array,
+      default: () => []
+    },
+    nodes: {
+      type: Array,
+      default: null
+    },
+    color: {
+      type: String,
+      default: 'primary'
+    },
+    dark: {
+      type: Boolean,
+      default: true
+    },
+    path: {
+      type: String,
+      default: ''
+    },
+    level: {
+      type: Number,
+      default: 0
+    }
+  },
+  data() {
+    return {
+      expanded: {},
+      storageKey: 'wikijs-nav-expanded-v1'
+    }
+  },
+  computed: {
+    tree() {
+      return this.nodes || this.buildTree(this.items)
+    },
+    indentStyle() {
+      return this.level > 0 ? { paddingLeft: `${this.level * 14}px` } : {}
+    },
+    currentPath() {
+      if (typeof window !== 'undefined' && window.location.pathname) {
+        return window.location.pathname
+      }
+      return this.path || '/'
+    }
+  },
+  created() {
+    this.restoreExpanded()
+    this.$nextTick(() => this.expandActiveNodes())
+  },
+  watch: {
+    path() {
+      this.$nextTick(() => this.expandActiveNodes())
+    },
+    tree: {
+      deep: true,
+      handler() {
+        this.$nextTick(() => this.expandActiveNodes())
+      }
+    }
+  },
+  methods: {
+    getId(item, index) {
+      return item.i || item.id || `nav-${this.level}-${index}`
+    },
+    buildTree(items) {
+      const source = Array.isArray(items) ? items : []
+      const nodes = source.map((item, index) => ({
+        ...item,
+        id: this.getId(item, index),
+        kind: item.k || item.kind || 'link',
+        label: item.l || item.label || '',
+        icon: item.c || item.icon || '',
+        targetType: item.y || item.targetType || 'page',
+        target: item.t || item.target || '',
+        parentId: item.p || item.parentId || null,
+        order: Number.isFinite(Number(item.o)) ? Number(item.o) : (Number.isFinite(Number(item.order)) ? Number(item.order) : index),
+        children: []
+      }))
+      const byId = _.keyBy(nodes, 'id')
+      const roots = []
+
+      // Keep backward compatibility with Wiki.js's original flat menu:
+      // a Header owns all following links until the next Header/Divider.
+      const hasExplicitParent = nodes.some(node => Boolean(node.parentId))
+      if (!hasExplicitParent) {
+        let currentSection = null
+        nodes.forEach(node => {
+          if (node.kind === 'header') {
+            currentSection = node
+            roots.push(node)
+          } else if (node.kind === 'link' && currentSection) {
+            currentSection.children.push(node)
+          } else {
+            currentSection = node.kind === 'divider' ? null : currentSection
+            roots.push(node)
+          }
+        })
+        const sortLegacy = list => {
+          list.sort((a, b) => a.order - b.order || String(a.id).localeCompare(String(b.id)))
+          list.forEach(item => sortLegacy(item.children))
+          return list
+        }
+        return sortLegacy(roots)
+      }
+
+      const hasCycle = (node, parent) => {
+        const seen = new Set([node.id])
+        let current = parent
+        while (current) {
+          if (seen.has(current.id)) return true
+          seen.add(current.id)
+          current = current.parentId ? byId[current.parentId] : null
+        }
+        return false
+      }
+
+      nodes.forEach(node => {
+        const parent = node.parentId ? byId[node.parentId] : null
+        if (parent && parent.id !== node.id && !hasCycle(node, parent)) {
+          parent.children.push(node)
+        } else {
+          roots.push(node)
+        }
+      })
+
+      // A site can contain a mixture of the original flat Header + Link format
+      // and the new explicit parentId format. Keep the old sections working for
+      // unparented items while leaving explicitly parented nodes untouched.
+      const groupedRoots = []
+      let currentSection = null
+      roots.forEach(node => {
+        if (node.parentId) {
+          currentSection = null
+          groupedRoots.push(node)
+        } else if (node.kind === 'header') {
+          currentSection = node
+          groupedRoots.push(node)
+        } else if (node.kind === 'link' && currentSection) {
+          currentSection.children.push(node)
+        } else {
+          if (node.kind === 'divider') currentSection = null
+          groupedRoots.push(node)
+        }
+      })
+
+      const sort = list => {
+        list.sort((a, b) => a.order - b.order || String(a.id).localeCompare(String(b.id)))
+        list.forEach(item => sort(item.children))
+        return list
+      }
+
+      return sort(groupedRoots)
+    },
+    isLink(node) {
+      return node.kind === 'link'
+    },
+    hasVisibleChildren(node) {
+      return this.level < 2 && node.children.length > 0
+    },
+    targetPath(target) {
+      if (!target) return ''
+      try {
+        return new URL(target, window.location.origin).pathname.replace(/\/$/, '') || '/'
+      } catch (err) {
+        return target.split('#')[0].replace(/\/$/, '') || '/'
+      }
+    },
+    isActive(node) {
+      if (!this.isLink(node)) return false
+      const target = this.targetPath(node.target)
+      const current = (this.currentPath || '/').split('#')[0].replace(/\/$/, '') || '/'
+      return target === current
+    },
+    hasActiveDescendant(node) {
+      return node.children.some(child => this.isActive(child) || this.hasActiveDescendant(child))
+    },
+    isExpanded(node) {
+      return this.expanded[node.id] !== false
+    },
+    toggle(node) {
+      this.$set(this.expanded, node.id, !this.isExpanded(node))
+      this.persistExpanded()
+    },
+    expandActiveNodes() {
+      const walk = nodes => nodes.forEach(node => {
+        if (this.hasActiveDescendant(node)) {
+          this.$set(this.expanded, node.id, true)
+        }
+        if (node.children.length > 0) walk(node.children)
+      })
+      walk(this.tree)
+      this.persistExpanded()
+    },
+    restoreExpanded() {
+      try {
+        const saved = JSON.parse(window.localStorage.getItem(this.storageKey) || '{}')
+        if (saved && typeof saved === 'object') this.expanded = saved
+      } catch (err) {
+        this.expanded = {}
+      }
+    },
+    persistExpanded() {
+      try {
+        window.localStorage.setItem(this.storageKey, JSON.stringify(this.expanded))
+      } catch (err) {
+        // Ignore storage restrictions (private browsing / disabled storage).
+      }
+    }
+  }
+}
+</script>
